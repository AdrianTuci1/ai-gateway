AGW_RUNTIME=persistent
AGW_DATABASE_URL=sqlite+aiosqlite:///./agw.db
AGW_PUBLIC_BASE_URL=http://127.0.0.1:8080
AGW_SECRET_KEY=change-me-in-production
AGW_BOOTSTRAP_ENABLED=true
AGW_BOOTSTRAP_TOKEN=change-me-bootstrap-token
AGW_DEV_AUTH=false
AGW_SIGNUP_ENABLED=true
AGW_IDENTITY_INVITE_TTL_HOURS=168
AGW_PASSWORD_AUTH_ENABLED=true
# Optional Google OIDC. Redirect URI: <AGW_PUBLIC_BASE_URL>/v1/auth/oidc/google/callback
# AGW_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# AGW_GOOGLE_CLIENT_SECRET=your-client-secret
AGW_GOOGLE_ALLOWED_DOMAINS=gmail.com
AGW_CA_DIR=./.agw-ca
AGW_LOG_LEVEL=info
