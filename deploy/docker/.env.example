# Copy to .env and replace every value.
POSTGRES_DB=agw
POSTGRES_USER=agw
# Hex keeps the password safe inside AGW_DATABASE_URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres

# At least 32 bytes. Generate with: openssl rand -base64 48
AGW_SECRET_KEY=change-me-session-and-vault-key

# Used once by POST /v1/bootstrap. Generate with: openssl rand -base64 48
AGW_BOOTSTRAP_ENABLED=true
AGW_BOOTSTRAP_TOKEN=change-me-bootstrap-token

# Public origin written into enrollment and device-flow links.
AGW_PUBLIC_BASE_URL=http://127.0.0.1:8080
AGW_PORT=8080
